TOKEN=<your discord token>
ENABLE_WEBSERVER=true
SERVERPORT=3001
ACCOUNT_REF_EXPIRE_TIME=3600000
OAUTH2_URI=<Your OAuth2 URI>
REDIRECT_URI=https://serveradress:PORT/auth/callback
SERVERURL=https://serveradress:PORT
CLIENT_ID=<Discord Client ID>
CLIENT_SECRET=<Discord Client Secret>
SMASHGG_API_KEY=<Start.gg API Key>
GUILD_ID=<ID of the discord server this bot shoud run on>
POST_TOURNAMENT_ROLE_NAME=<Name of the role that gives access to the post tournament action>
TOURNAMENT_AGENDA_ID=<ID of the channel where tournaments should be posted>
ONLINE_TOURNAMENT_AGENDA_ID=<ID of the channel where online tournaments should be posted>
PUBLIC_INVITE_LINK=<Link To Discord Invite>
DATABASE_PATH=<Path to the SQLite database file, defaults to data/turnipinator.db>
NEE_ROLE_IDS=<a json array of strings of nee roles>
# Nightly SQLite backup (04:00 Europe/Amsterdam), in-process. Off unless "true".
BACKUP_ENABLED=false
BACKUP_DIR=<Directory for the last 7 local snapshots, defaults to backups/ next to the DB>
# Optional off-site copy to an S3-compatible bucket (e.g. Cloudflare R2). Set all four or none.
BACKUP_S3_BUCKET=<Bucket name>
BACKUP_S3_ENDPOINT=<https://<account-id>.r2.cloudflarestorage.com>
BACKUP_S3_ACCESS_KEY_ID=<Access key ID of a token scoped to that bucket>
BACKUP_S3_SECRET_ACCESS_KEY=<Secret access key of that token>
