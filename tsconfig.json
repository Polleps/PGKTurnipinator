{
  "compilerOptions": {
    "target": "es2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": ["bun"],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "esModuleInterop": true,
    "strict": true,
    // Bun transpiles each file on its own; flag what only tsc's whole-program emit
    // could handle (e.g. ambient const enums, which caught scheduleEvent.ts).
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": ["./src/**/*", "./scripts/**/*", "./test/**/*"]
}
