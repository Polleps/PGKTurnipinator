{
  "name": "pgk-turnipinator",
  "version": "3.0.1",
  "description": "This repository contains the Discord bot for the Dutch Smash Ultimate Discord.",
  "main": "src/bot.ts",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": "1.4.4"
  },
  "workspaces": {
    "packages": [
      "agenda",
      "public"
    ],
    "catalog": {
      "solid-js": "1.9.19",
      "vite": "8.3.8",
      "vite-plugin-solid": "2.11.16"
    }
  },
  "scripts": {
    "test": "bun --no-env-file test",
    "dev": "bun --watch --no-env-file src/bot.ts",
    "start": "bun --no-env-file src/bot.ts",
    "prod": "NODE_ENV=production bun --no-env-file src/bot.ts",
    "debug": "bun --inspect --no-env-file src/bot.ts",
    "build": "bun run --filter agenda_src --filter public build",
    "typecheck": "tsc && tsc -p agenda && tsc -p public",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt:check": "bun fmt --check",
    "export:firestore": "node scripts/export-firestore.ts",
    "import:firestore": "bun --no-env-file scripts/import-firestore-export.ts",
    "db:generate": "drizzle-kit generate",
    "commands": "bun --no-env-file scripts/register-commands.ts",
    "backup:now": "bun --no-env-file scripts/backup-now.ts"
  },
  "author": "Polle Pas",
  "license": "ISC",
  "dependencies": {
    "discord.js": "14.28.1",
    "dotenv": "6.2.0",
    "drizzle-orm": "0.45.4",
    "express": "4.16.4",
    "jsonwebtoken": "9.0.3",
    "moment": "2.24.0",
    "moment-timezone": "^0.5.31"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/dotenv": "6.1.0",
    "@types/express": "4.17.25",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "^26",
    "drizzle-kit": "0.31.11",
    "firebase-admin": "14.5.1",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2007",
    "typescript": "7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Polleps/PGKTurnipinator.git"
  },
  "keywords": [],
  "bugs": {
    "url": "https://github.com/Polleps/PGKTurnipinator/issues"
  },
  "homepage": "https://github.com/Polleps/PGKTurnipinator#readme"
}
