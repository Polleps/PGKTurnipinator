{
  "name": "pgk-turnipinator",
  "version": "3.0.1",
  "description": "This repository contains the Discord bot for the Dutch Smash Ultimate Discord.",
  "main": "src/bot.ts",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": "1.4.4"
  },
  "scripts": {
    "test": "bun --no-env-file test",
    "dev": "bun --watch --env-file=.env.dev src/bot.ts",
    "start": "NODE_ENV=production bun --env-file=.env.prod src/bot.ts",
    "prod": "NODE_ENV=production bun --env-file=.env.prod src/bot.ts",
    "debug": "bun --inspect --env-file=.env.dev src/bot.ts",
    "build": "tsc --noEmit",
    "buildall": "./build.sh",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "export:firestore": "tsc -p scripts && node ./built-scripts/scripts/export-firestore.js"
  },
  "author": "Polle Pas",
  "license": "ISC",
  "dependencies": {
    "body-parser": "1.18.3",
    "discord.js": "^13.6.0",
    "dotenv": "6.2.0",
    "express": "4.16.4",
    "firebase-admin": "^10.0.0",
    "jsonwebtoken": "9.0.3",
    "moment": "2.24.0",
    "moment-timezone": "^0.5.31",
    "node-fetch": "^2.6.1"
  },
  "devDependencies": {
    "@types/dotenv": "6.1.0",
    "@types/express": "4.16.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "14.18.3",
    "@types/node-fetch": "2.1.4",
    "oxlint": "1.93.0",
    "typescript": "^4.5.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Polleps/PGKTurnipinator.git"
  },
  "keywords": [],
  "bugs": {
    "url": "https://github.com/Polleps/PGKTurnipinator/issues"
  },
  "homepage": "https://github.com/Polleps/PGKTurnipinator#readme"
}
