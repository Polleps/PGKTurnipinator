{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import"],
  "options": {
    "typeAware": true
  },
  "categories": {
    "correctness": "warn"
  },
  "env": {
    "node": true,
    "es2022": true
  },
  "ignorePatterns": ["**/dist/**", "**/node_modules/**"]
}
